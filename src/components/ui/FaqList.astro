---
import type { CollectionEntry } from 'astro:content';
interface Props { faqs: CollectionEntry<'faqs'>[] }
const { faqs } = Astro.props;
---

<div class="flex flex-col">
  {
    faqs.map((f) => (
      <details class="group border-b border-line-strong py-[18px]">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-[17px] font-semibold [&::-webkit-details-marker]:hidden">
          {f.data.question}
          <svg class="mt-1 size-4 shrink-0 transition-transform group-open:rotate-45" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M8 2v12M2 8h12" stroke-linecap="round" />
          </svg>
        </summary>
        <p class="mt-2.5 mb-0 leading-relaxed text-muted">{f.body?.trim()}</p>
      </details>
    ))
  }
</div>
