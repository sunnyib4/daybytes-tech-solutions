---
/** One labelled form control with optional hint and inline error (used by AjaxForm). */
interface Option { value: string; label: string; selected?: boolean }
interface Props {
  id: string;
  label: string;
  name?: string;
  type?: 'text' | 'email' | 'tel' | 'url' | 'file' | 'textarea' | 'select';
  required?: boolean;
  autocomplete?: string;
  options?: Option[];
  /** First, empty option for selects. */
  placeholderOption?: string;
  /** Query-string parameter that pre-selects a value, e.g. ?program=frontend-web-development. */
  prefill?: string;
  hint?: string;
  error?: string;
  accept?: string;
  maxMb?: number;
  rows?: number;
  wide?: boolean;
}
const { id, label, name = id, type = 'text', required = false, autocomplete, options = [], placeholderOption, prefill, hint, error, accept, maxMb, rows = 5, wide = false } = Astro.props;

const control =
  'w-full rounded-[10px] border border-line-strong bg-canvas px-4 py-3.5 text-base text-ink placeholder:text-subtle focus:border-accent aria-[invalid=true]:border-[#B42318] dark:aria-[invalid=true]:border-[#FF8A80]';
const fileControl =
  'w-full rounded-[10px] border border-dashed border-line-strong bg-canvas px-3 py-3 text-[15px] text-body file:mr-4 file:cursor-pointer file:rounded-lg file:border-0 file:bg-tile file:px-4 file:py-2 file:font-mono file:text-sm file:text-accent';
const describedBy = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined;
const common = { id, name, required, 'aria-describedby': describedBy, autocomplete };
---

<div class:list={[wide && 'sm:col-span-2']}>
  <label for={id} class="mb-2 block text-sm font-medium">
    {label}
    {required ? <span aria-hidden="true" class="text-accent-text"> *</span> : <span class="font-normal text-subtle"> (optional)</span>}
  </label>
  {hint && <p id={`${id}-hint`} class="mt-0 mb-2 text-sm text-subtle">{hint}</p>}
  {
    type === 'textarea' ? (
      <textarea {...common} rows={rows} class={control} />
    ) : type === 'select' ? (
      <select {...common} data-prefill={prefill} class={control}>
        {placeholderOption && <option value="">{placeholderOption}</option>}
        {options.map((o) => (
          <option value={o.value} selected={o.selected}>
            {o.label}
          </option>
        ))}
      </select>
    ) : (
      <input {...common} type={type} accept={accept} data-max-mb={maxMb} inputmode={type === 'tel' ? 'tel' : undefined} class={type === 'file' ? fileControl : control} />
    )
  }
  {
    error && (
      <p id={`${id}-error`} data-error hidden class="mt-1.5 mb-0 text-sm text-[#B42318] dark:text-[#FF8A80]">
        {error}
      </p>
    )
  }
</div>
