---
import { nav, site } from '@/data/site';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class:list={[overlay ? 'absolute inset-x-0 top-0' : 'relative', 'z-30']}>
  <div class="mx-auto flex max-w-[1280px] items-center justify-between gap-2 px-4 pt-6 sm:gap-5 sm:px-6">
    <a href="/" class="flex min-w-0 items-center gap-2 text-ink no-underline sm:gap-3">
      <Logo size={36} class="size-8 sm:size-9" />
      <span aria-hidden="true" class="max-[360px]:hidden text-[26px] font-medium tracking-[-0.03em] sm:text-[30px]">Daybytes</span>
      <span class="sr-only">home</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-0.5 rounded-[10px] bg-surface py-1.5 pr-1.5 pl-3 font-mono text-sm lg:flex xl:gap-1 xl:pl-[18px]">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="rounded-md px-2.5 py-3 no-underline hover:text-accent-text xl:px-3.5 aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[6px]"
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle class="ml-1" />
      <a href={site.phone.href} target="_blank" rel="noopener noreferrer" class="ml-1 hidden rounded-lg border-[1.5px] border-ink px-[18px] py-[11px] no-underline hover:bg-ink hover:text-surface xl:inline-block">
        Call us
      </a>
      <a href={site.calendly} target="_blank" rel="noopener noreferrer" class="btn-accent rounded-lg px-[18px] py-3">Book a free call</a>
    </nav>

    <div class="flex shrink-0 items-center gap-1 lg:hidden sm:gap-2">
      <ThemeToggle class="shrink-0 bg-surface" />
      <button
        type="button"
        id="menu-button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="inline-flex h-11 shrink-0 items-center gap-2 rounded-lg bg-surface px-3 font-mono text-sm text-ink sm:px-4"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
        Menu
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Main" hidden class="mx-4 mt-3 rounded-xl bg-surface p-3 font-mono text-[15px] shadow-[0_18px_40px_rgba(0,0,0,.18)] sm:mx-6 lg:hidden">
    <ul class="flex flex-col">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="block rounded-lg px-3 py-3 no-underline hover:bg-canvas aria-[current=page]:text-accent-text"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-2 grid grid-cols-2 gap-2">
      <a href={site.phone.href} target="_blank" rel="noopener noreferrer" class="rounded-lg border-[1.5px] border-ink px-3 py-3 text-center no-underline">Call us</a>
      <a href={site.calendly} target="_blank" rel="noopener noreferrer" class="btn-accent rounded-lg px-3 py-3">Book a free call</a>
    </div>
  </nav>
</header>

<script>
  import { onPageLoad } from '@/scripts/lifecycle';

  onPageLoad((signal) => {
    const button = document.getElementById('menu-button');
    const panel = document.getElementById('mobile-nav');
    if (button && panel) {
      const setOpen = (open: boolean) => {
        button.setAttribute('aria-expanded', String(open));
        panel.hidden = !open;
        document.body.classList.toggle('overflow-hidden', open);
      };
      button.addEventListener('click', () => setOpen(panel.hasAttribute('hidden')), { signal });
      document.addEventListener('astro:page-load', () => setOpen(false), { signal });
      document.addEventListener(
        'keydown',
        (e) => {
          if (e.key === 'Escape' && !panel.hidden) {
            setOpen(false);
            button.focus();
          }
        },
        { signal },
      );
    }

    const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')];
    const sync = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      toggles.forEach((t) => t.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme'));
    };
    sync();
    toggles.forEach((toggle) =>
      toggle.addEventListener(
        'click',
        () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
          sync();
        },
        { signal },
      ),
    );
  });
</script>
