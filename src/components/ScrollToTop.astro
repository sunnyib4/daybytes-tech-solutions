---
---

<button
  type="button"
  data-scroll-to-top
  aria-label="Scroll to top"
  title="Scroll to top"
  hidden
  class="fixed right-5 bottom-[calc(env(safe-area-inset-bottom)+5.25rem)] z-40 inline-flex size-12 items-center justify-center rounded-full border border-line-strong bg-surface text-ink shadow-[0_8px_24px_rgba(26,23,20,.18)] transition-[opacity,transform,background-color] hover:-translate-y-0.5 hover:bg-canvas focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
>
  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path d="M12 19V5m-6 6 6-6 6 6" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  import { onPageLoad } from '@/scripts/lifecycle';

  onPageLoad((signal) => {
    const button = document.querySelector<HTMLButtonElement>('[data-scroll-to-top]');
    if (!button) return;

    const syncVisibility = () => {
      button.hidden = window.scrollY <= 600;
    };

    syncVisibility();
    window.addEventListener('scroll', syncVisibility, { passive: true, signal });
    button.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    }, { signal });
  });
</script>
