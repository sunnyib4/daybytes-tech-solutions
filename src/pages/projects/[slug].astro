---
export const prerender = true;

import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ConsultCard from '@/components/ui/ConsultCard.astro';
import { formatDate, getProjects, render } from '@/lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length], nextNumber: ((i + 1) % projects.length) + 1 },
  }));
}) satisfies GetStaticPaths;

const { project, next, nextNumber } = Astro.props;
const { Content } = await render(project);
const { title, client, category, summary, image, imageAlt, date, liveUrl, codeUrl, context, chips, metrics, caseStudy } = project.data;
const service = await getEntry(project.data.service);
const hasNotes = Boolean(project.body?.trim());
const cleanedSummary = summary.trim();
const projectImage = new URL(`/projects/${project.id}.png`, Astro.site).href;
const isDraft = JSON.stringify(project.data).includes('[TO CONFIRM]') || project.body?.includes('[TO CONFIRM]') === true;
const pad = (n: number) => String(n).padStart(2, '0');
const steps = ['The problem', 'What we did', 'The result'];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description: cleanedSummary,
  image: projectImage,
  url: new URL(`/projects/${project.id}`, Astro.site).href,
  creator: { '@type': 'Organization', name: 'Daybytes Tech Solutions', url: 'https://daybytes.com' },
  publisher: { '@type': 'Organization', name: 'Daybytes Tech Solutions', url: 'https://daybytes.com' },
  keywords: chips.join(', '),
  ...(date ? { dateCreated: date.toISOString() } : {}),
};
---

<BaseLayout title={`${title} Project`} description={`${cleanedSummary.slice(0, 145).trimEnd()}${cleanedSummary.length > 145 ? '…' : ''}`} image={projectImage} noindex={isDraft} overlayHeader>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <PageHero
    eyebrow={category}
    title={title}
    intro={summary}
    breadcrumbs={[
      { label: 'Projects', href: '/projects' },
      { label: client, href: `/projects/${project.id}` },
    ]}
  >
    <dl class="mt-8 mb-0 flex flex-wrap gap-x-10 gap-y-4 text-[15px]">
      <div>
        <dt class="label-mono mb-1 text-subtle">Client</dt>
        <dd class="m-0 font-medium">{client}</dd>
      </div>
      {
        service && (
          <div>
            <dt class="label-mono mb-1 text-subtle">Service</dt>
            <dd class="m-0 font-medium">
              <a href={`/services/${service.id}`} class="link">
                {service.data.title}
              </a>
            </dd>
          </div>
        )
      }
      {
        date && (
          <div>
            <dt class="label-mono mb-1 text-subtle">Completed</dt>
            <dd class="m-0 font-medium">
              <time datetime={date.toISOString()}>{formatDate(date)}</time>
            </dd>
          </div>
        )
      }
      {
        liveUrl && (
          <div>
            <dt class="label-mono mb-1 text-subtle">Live site</dt>
            <dd class="m-0 font-medium">
              <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="link">
                {new URL(liveUrl).hostname} <span aria-hidden="true">↗</span>
              </a>
            </dd>
          </div>
        )
      }
    </dl>
    {
      chips.length > 0 && (
        <ul class="mt-6 mb-0 flex list-none flex-wrap gap-2 p-0" aria-label="Services">
          {chips.map((chip) => (
            <li class="rounded-full border border-line-strong px-3 py-1 font-mono text-xs text-body">{chip}</li>
          ))}
        </ul>
      )
    }
    {
      context && (
        <p class="mt-5 mb-0 max-w-[680px] font-mono text-[13px] uppercase tracking-[0.08em] text-subtle">{context}</p>
      )
    }
    {
      liveUrl && (
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="btn-accent rounded-full px-5 py-3.5 text-base font-medium">
            Visit live site
          </a>
          {codeUrl && (
            <a href={codeUrl} target="_blank" rel="noopener noreferrer" class="btn-dark rounded-full px-5 py-3.5 text-base font-medium">
              View code
            </a>
          )}
        </div>
      )
    }
  </PageHero>

  <div class="px-4 sm:px-6">
    <div data-reveal class="mx-auto max-w-[1100px] overflow-hidden rounded-[22px] border border-line bg-placeholder">
      <Image src={image} alt={imageAlt} widths={[640, 1000, 1400]} sizes="(min-width: 1148px) 1100px, 100vw" loading="eager" class="block w-full" />
    </div>
  </div>

  <section aria-label="Results in numbers" class="px-4 pt-14 sm:px-6">
    <div class="mx-auto max-w-[1100px]">
      {
        metrics.length > 0 ? (
          <dl data-reveal-stagger class="m-0 grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-6">
            {metrics.map((m) => (
              <div class="flex flex-col border-t-[1.5px] border-ink pt-4">
                <dt class="mt-2 text-base leading-normal text-muted">{m.label}</dt>
                <dd class="heading-serif order-first m-0 text-[56px] leading-none text-accent-text md:text-[72px]">{m.value}</dd>
              </div>
            ))}
          </dl>
        ) : (
          <div class="rounded-[14px] border border-dashed border-line-strong bg-accent/5 px-5 py-4 text-sm text-subtle">
            <p class="m-0 font-mono text-[12px] uppercase tracking-[0.08em] text-accent">Dev note</p>
            <p class="mt-2 mb-0">Result: {caseStudy.outcome}</p>
          </div>
        )
      }
    </div>
  </section>

  <section aria-label="Case study" class="px-4 py-16 sm:px-6">
    <ol class="mx-auto m-0 flex max-w-[1100px] list-none flex-col p-0">
      {
        steps.map((label, i) => (
          <li data-reveal class="grid gap-4 border-t border-line py-10 md:grid-cols-[260px_minmax(0,1fr)] md:gap-12">
            <div class="md:sticky md:top-8 md:self-start">
              <span aria-hidden="true" class="font-serif text-[44px] leading-none font-bold text-accent-text md:text-[56px]">
                {pad(i + 1)}
              </span>
              <h2 class="heading-serif mt-2 mb-0 text-[26px]">{label}</h2>
            </div>
            <div class="max-w-[68ch] text-lg leading-relaxed text-body">
              {i === 0 && <p class="m-0">{caseStudy.problem}</p>}
              {i === 1 && (
                <ul class="m-0 flex list-none flex-col gap-4 p-0">
                  {caseStudy.approach.map((step) => (
                    <li class="flex gap-3">
                      <svg class="mt-1.5 size-5 shrink-0 text-accent" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      <span>{step}</span>
                    </li>
                  ))}
                </ul>
              )}
              {i === 2 && (
                <>
                  <p class="m-0">{caseStudy.outcome}</p>
                  {caseStudy.quote && (
                    <figure class="mx-0 mt-8 mb-0 rounded-[18px] bg-[#1A1714] p-7 text-[#F4F3F1] sm:p-9 dark:bg-surface dark:ring-1 dark:ring-line">
                      <blockquote class="m-0 font-serif text-[22px] leading-snug font-semibold sm:text-[26px]">
                        <span aria-hidden="true" class="text-accent">“</span>
                        {caseStudy.quote.text}
                        <span aria-hidden="true" class="text-accent">”</span>
                      </blockquote>
                      <figcaption class="mt-5 font-mono text-sm text-[#D6D0C9]">
                        {caseStudy.quote.name} · {caseStudy.quote.role}
                      </figcaption>
                    </figure>
                  )}
                </>
              )}
            </div>
          </li>
        ))
      }
    </ol>
    {
      hasNotes && (
        <div class="prose prose-lg mx-auto mt-6 max-w-[1100px] border-t border-line pt-10">
          <Content />
        </div>
      )
    }
  </section>

  {
    next.id !== project.id && (
      <section aria-label="Next project" class="px-4 pb-16 sm:px-6">
        <a
          href={`/projects/${next.id}`}
          class="group mx-auto flex max-w-[1100px] flex-wrap items-center justify-between gap-6 rounded-[28px] border border-line bg-surface p-7 text-ink no-underline transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_18px_40px_rgba(0,0,0,.1)] sm:p-9"
        >
          <span class="flex items-baseline gap-5">
            <span aria-hidden="true" class="font-serif text-[44px] leading-none font-bold text-accent-text">
              {pad(nextNumber)}
            </span>
            <span>
              <span class="label-mono block text-subtle">Next project · {next.data.category}</span>
              <span class="heading-serif mt-1 block text-2xl sm:text-[30px]">{next.data.title}</span>
            </span>
          </span>
          <svg class="size-8 shrink-0 transition-transform duration-300 group-hover:translate-x-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </section>
    )
  }

  <section aria-label="Get in touch" class="px-4 pb-24 sm:px-6">
    <ConsultCard selected={service?.id} class="mx-auto max-w-[760px]" />
  </section>
</BaseLayout>
