---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AjaxForm from '@/components/forms/AjaxForm.astro';
import Field from '@/components/forms/Field.astro';
---

<BaseLayout title="Brevo test form" description="Internal test form for verifying transactional email delivery." noindex overlayHeader>
  <section class="mx-auto max-w-xl px-4 py-20 sm:px-6">
    <div class="rounded-2xl border border-line bg-surface/80 p-8 shadow-sm">
      <p class="label-mono mb-3 text-xs uppercase tracking-[0.18em] text-subtle">Developer test</p>
      <h1 class="mt-0 text-3xl font-medium tracking-[-0.04em] text-ink">Brevo delivery test</h1>
      <p class="mt-4 text-base text-body">Internal test page for verifying the configured Worker mail provider.</p>
      <AjaxForm id="mail-test-form" form="contact" subject="Daybytes mail test" submitLabel="Send test email" success="Test message sent.">
        <Field id="name" label="Your name" required error="Please enter your name." />
        <Field id="email" label="Your email" type="email" required error="Please enter a valid email address." />
        <Field id="service" label="Service" type="select" required placeholderOption="Choose a service" options={[{ value: 'test', label: 'Mail delivery test' }]} error="Please choose a service." />
        <Field id="message" label="Test message" type="textarea" required wide error="Please enter a test message." />
      </AjaxForm>
    </div>
  </section>
</BaseLayout>
