---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Brevo test form" description="Internal test form for verifying transactional email delivery." noindex overlayHeader>
  <section class="mx-auto max-w-xl px-4 py-20 sm:px-6">
    <div class="rounded-2xl border border-line bg-surface/80 p-8 shadow-sm">
      <p class="label-mono mb-3 text-xs uppercase tracking-[0.18em] text-subtle">Developer test</p>
      <h1 class="mt-0 text-3xl font-medium tracking-[-0.04em] text-ink">Brevo delivery test</h1>
      <p class="mt-4 text-base text-body">
        This form posts directly to the secure Brevo route so you can validate email delivery using a minimal payload.
      </p>

      <form action="/api/contact" method="POST" class="mt-8 space-y-5">
        <div>
          <label for="name" class="mb-2 block text-sm font-medium text-ink">First name</label>
          <input id="name" name="name" type="text" required class="w-full rounded-xl border border-line bg-canvas px-3 py-3 text-base text-ink outline-none transition focus:border-accent" placeholder="Jane" />
        </div>

        <div>
          <label for="email" class="mb-2 block text-sm font-medium text-ink">Email</label>
          <input id="email" name="email" type="email" required class="w-full rounded-xl border border-line bg-canvas px-3 py-3 text-base text-ink outline-none transition focus:border-accent" placeholder="Enter your email address" />
        </div>

        <button type="submit" class="btn-accent w-full justify-center px-6 py-4 text-base">Send test email</button>
      </form>
    </div>
  </section>
</BaseLayout>
