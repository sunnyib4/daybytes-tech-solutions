---
export const prerender = true;

import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import PostCard from '@/components/ui/PostCard.astro';
import ConsultCard from '@/components/ui/ConsultCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/data/site';
import { formatDate, getPosts, render } from '@/lib/content';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, author, category, image, imageAlt } = post.data;

const ogImage = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const others = (await getPosts()).filter((p) => p.id !== post.id).slice(0, 2);
const url = new URL(`/blog/${post.id}`, Astro.site).href;
const relatedLink = post.id.includes('laptop')
  ? { href: '/services/computer-sales-and-repair', label: 'Explore computer sales and repair services' }
  : { href: '/services/it-support', label: 'Explore IT support services for small businesses' };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: new URL(ogImage.src, Astro.site).href,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: { '@id': `${site.url}/#business` },
  mainEntityOfPage: url,
};
---

<BaseLayout title={title} description={`${description.slice(0, 145).trimEnd()}${description.length > 145 ? '…' : ''}`} image={ogImage.src} type="article" overlayHeader>
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta property="article:section" content={category} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <article>
    <header class="bg-[image:var(--page-gradient)] px-4 pt-[124px] pb-10 sm:px-6 lg:pt-[148px]">
      <div class="mx-auto max-w-[760px]">
        <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }, { label: title, href: `/blog/${post.id}` }]} />
        <p class="m-0 mb-4 font-mono text-[13px] text-subtle">
          Published <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && <> · Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>} · {category} · By {author}
        </p>
        <h1 class="heading-serif m-0 text-[36px] leading-[1.1] text-balance sm:text-[48px]">{title}</h1>
        <p class="mt-5 mb-0 text-lg leading-normal text-body sm:text-xl">{description}</p>
      </div>
    </header>

    <div class="px-4 sm:px-6">
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 800, 1100]}
        sizes="(min-width: 1148px) 1100px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="mx-auto block aspect-[16/8] w-full max-w-[1100px] rounded-[18px] object-cover"
      />
    </div>

    <div class="prose prose-lg mx-auto max-w-[760px] px-4 py-14 sm:px-0">
      <Content />
      <p><a href={relatedLink.href}>{relatedLink.label}</a></p>
      <p><a href="/training">Browse practical technology training programs</a></p>
    </div>
  </article>

  <section aria-label="Get in touch" class="px-4 pb-16 sm:px-6">
    <ConsultCard class="mx-auto max-w-[760px]" />
  </section>

  {
    others.length > 0 && (
      <section aria-labelledby="more-title" class="px-4 pb-24 sm:px-6">
        <div class="mx-auto max-w-[1100px]">
          <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <SectionHeading id="more-title">More insights</SectionHeading>
            <a href="/blog" class="link font-mono text-sm">All posts <span class="arrow" aria-hidden="true">→</span></a>
          </div>
          <div data-reveal-stagger class="grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-5">
            {others.map((p) => <PostCard post={p} />)}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
