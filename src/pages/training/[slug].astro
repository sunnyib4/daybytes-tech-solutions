---
export const prerender = true;

import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ProgramCard from '@/components/training/ProgramCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/data/site';
import { formatDate, formatLabel, getPrograms, render } from '@/lib/content';

export const getStaticPaths = (async () => {
  const programs = await getPrograms();
  return programs.map((program) => ({ params: { slug: program.id }, props: { program } }));
}) satisfies GetStaticPaths;

const { program } = Astro.props;
const { Content } = await render(program);
const { title, code, category, summary, audience, outcomes, format, level, duration, price, nextStart } = program.data;
const hasBody = Boolean(program.body?.trim());
const applyHref = `/training/apply?program=${program.id}`;

const all = await getPrograms();
const related = [...all.filter((p) => p.id !== program.id && p.data.category === category), ...all.filter((p) => p.id !== program.id && p.data.category !== category)].slice(0, 3);

const facts = [
  { label: 'Format', value: formatLabel(format) },
  { label: 'Level', value: level },
  ...(duration ? [{ label: 'Duration', value: duration }] : []),
  ...(price ? [{ label: 'Price', value: price }] : []),
  ...(nextStart ? [{ label: 'Next start', value: nextStart instanceof Date ? formatDate(nextStart) : nextStart }] : []),
].filter((fact) => fact.value && String(fact.value).trim() !== '');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: title,
  description: summary,
  url: new URL(`/training/${program.id}`, Astro.site).href,
  provider: { '@type': 'Organization', name: site.name, sameAs: site.url },
  educationalLevel: level,
  teaches: outcomes,
};
---

<BaseLayout title={`${title} Training`} description={summary} image="/og/default.png" overlayHeader>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <PageHero
    eyebrow={category}
    title={title}
    intro={summary}
    breadcrumbs={[
      { label: 'Training', href: '/training' },
      { label: title, href: `/training/${program.id}` },
    ]}
  >
    <div class="mt-9 flex flex-wrap gap-3.5">
      <a href={applyHref} class="btn-accent px-7 py-4 text-lg">Apply / Enrol</a>
      <a href={site.calendly} class="btn-dark px-7 py-4 text-lg font-normal">Ask us a question</a>
    </div>
  </PageHero>

  <section aria-label="Program details" class="px-4 pt-6 pb-16 sm:px-6">
    <div class="mx-auto grid max-w-[1100px] grid-cols-[minmax(0,1fr)] items-start gap-10 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-16">
      <div class="flex min-w-0 flex-col gap-14">
        <div data-reveal>
          <h2 class="heading-serif m-0 mb-5 text-[30px]">What you'll learn</h2>
          <ul class="m-0 grid list-none gap-3 p-0 md:grid-cols-2">
            {
              outcomes.map((o) => (
                <li class="flex gap-3 rounded-[14px] border border-line bg-surface p-4 leading-relaxed">
                  <svg class="mt-1 size-5 shrink-0 text-accent" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{o}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div data-reveal>
          <h2 class="heading-serif m-0 mb-5 text-[30px]">Who it's for</h2>
          <ul class="m-0 flex list-none flex-col gap-3 p-0 text-lg leading-relaxed text-body">
            {
              audience.map((a, i) => (
                <li class="flex gap-4">
                  <span aria-hidden="true" class="pt-1 font-mono text-sm text-accent-text">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span>{a}</span>
                </li>
              ))
            }
          </ul>
        </div>

        {
          hasBody && (
            <div class="prose prose-lg max-w-none">
              <Content />
            </div>
          )
        }
      </div>

      <aside class="rounded-[18px] bg-[#1A1714] p-7 text-[#F4F3F1] lg:sticky lg:top-6 dark:bg-surface dark:ring-1 dark:ring-line" aria-labelledby="facts-title">
        <div class="mb-6 flex items-center gap-4">
          <span aria-hidden="true" class="flex size-14 shrink-0 items-center justify-center rounded-[12px] bg-[#2A2622] font-mono text-[17px] text-accent">{code}</span>
          <h2 id="facts-title" class="heading-serif m-0 text-2xl">Program details</h2>
        </div>
        <dl class="m-0 grid gap-4 text-[15px]">
          {
            facts.map((f) => (
              <div class="flex justify-between gap-4 border-b border-white/10 pb-3">
                <dt class="label-mono text-[#B5ADA5]">{f.label}</dt>
                <dd class="m-0 text-right font-medium">{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <a href={applyHref} class="btn-accent mt-6 w-full px-6 py-4">Apply / Enrol</a>
        <p class="mt-4 mb-0 text-center text-sm text-[#D6D0C9]">
          Training a team? <a href={`/training/apply?program=${program.id}&as=team`} class="text-white underline-offset-4 hover:underline">Ask about group training</a>
        </p>
      </aside>
    </div>
  </section>

  <p class="mx-auto max-w-[1100px] px-4 pb-8 text-sm text-muted sm:px-6">If you need other information, please <a href="/contact" class="link">reach out</a>. <a href="/training#faq" class="link">Read answers to common training questions</a></p>

  <section aria-labelledby="more-programs" class="px-4 pb-24 sm:px-6">
    <div class="mx-auto max-w-[1100px]">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <SectionHeading id="more-programs">More programs</SectionHeading>
        <a href="/training#programs" class="link font-mono text-sm">All programs <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul data-reveal-stagger class="m-0 grid list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => <li><ProgramCard program={p} /></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
