/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self' https://*.calendly.com; frame-ancestors 'none'; object-src 'none'; frame-src 'self' https://*.calendly.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://*.calendly.com; connect-src 'self' https://api.brevo.com https://*.calendly.com; media-src 'self'; worker-src 'self' blob:;
